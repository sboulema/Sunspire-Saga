        "ina":   {"name": "Ina", "sprite": "ina", "map": "brindle", "x": 24, "y": 13, "wander": true, "voice": "child_1",
                  "dialog": [{"lines": ["INA: 'Papa runs the inn. Twelve coins and you sleep like a golem!'", "'He snores louder than the mine carts, though. You did not hear that from me.'"]}]},
