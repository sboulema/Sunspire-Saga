    "npcs": {
        "elder": {"name": "Sorin", "sprite": "elder", "map": "fields", "x": 11, "y": 21, "wander": false, "voice": "elder_1",
                  "dialog": [
                      {"unless": "boss_down", "unless_spirits": 8, "lines": ["SORIN: 'The spirits scattered when the SHADOW WYRM darkened the spire.'", "'FLINT hides west of the houses. Another skims the lake.'", "'The rest fled north - to Brindle's mine, the high trail, the spire itself.'", "'MARA keeps the shop by the lane. The inn up in Brindle rests weary bones.'"]},
                      {"unless": "boss_down", "lines": ["SORIN: 'All eight walk with you! Unleash them in battle and call the great summons.'", "'Now climb, Ari. Bring back the dawn.'"]},
                      {"lines": ["SORIN: 'The dawn is yours. Thera will sing of this day.'"]}]},
        "mara":  {"name": "Mara", "sprite": "mara", "map": "fields", "x": 16, "y": 20, "wander": true, "voice": "adult_female_1",
                  "dialog": [{"lines": ["MARA: 'Just picking mint for the shop counter. Smell that? Lovely.'", "'Door's open if you need blades or herbs - let yourself in!'"]}]},
        "polly": {"name": "Polly", "sprite": "polly", "map": "fields", "x": 24, "y": 21, "wander": true, "voice": "child_1",
                  "dialog": [{"unless_spirit": "flint", "lines": ["POLLY: 'I saw a little stone critter wink at me behind the west house!'", "'Grown-ups never believe me. YOU believe me, right?'"]},
                             {"lines": ["POLLY: 'You FOUND the stone critter! I knew it was real!'", "'When I grow up I'm going to collect ALL the spirits.'"]}]},
        "hob":   {"name": "Hob", "sprite": "hob", "map": "fields", "x": 48, "y": 35, "wander": true, "voice": "adult_male_1",
                  "dialog": [{"lines": ["HOB: 'Fields run clear to the east woods these days. Mind the tall grass - things bite.'", "'The inn is my sister's. Tell her Hob sent you. She will still charge you twelve.'"]}]},
        "dov":   {"name": "Dov", "sprite": "dov", "map": "brindle", "x": 8, "y": 9, "wander": false, "voice": "adult_male_1", "shop": "brindle",
                  "dialog": [{"lines": ["DOV: 'Iron from our own seams. Best gear north of Thera.'"]}]},
        "miner": {"name": "Miner", "sprite": "miner", "map": "brindle", "x": 20, "y": 11, "wander": true, "voice": "adult_male_1",
                  "dialog": [{"unless": "ogre", "lines": ["MINER: 'A MAW OGRE nests in the east gallery, squatting on the old SPIRE KEY.'", "'It flattened three carts. Mind your skulls.'"]},
