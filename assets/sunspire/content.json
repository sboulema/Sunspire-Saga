    "rules": {
        "xp_next": "18 + 12 * level",
        "max_level": 30,
        "pp_regen": "1 PP per party member every 8 steps",
        "encounter": {"steps_before": 5, "chance": 0.15, "tiles": "tall grass and rubble"},
        "flee_chance": 0.6,
        "defend": "halves damage",
        "set_bonus": "+1 attack and +1 defence per set spirit",
        "attack": "atk + weapon + set bonus + rnd(0,4) - enemy def; bosses and spirits take 50% / 30% of it",
        "art": "power + atk/2 + level + rnd(0,3) - enemy def; area arts do 70% to all but the target",
        "spirit": "power + level*4 + rnd(0,3) - enemy def/2",
        "summon": "power + level*5 + rnd(0,5) - enemy def/2, to every foe",
        "enemy_attack": "atk + rnd(0,4) - (def + armour + set bonus)"
    },

