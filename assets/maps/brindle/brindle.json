        "tile_event/01": "{\"type\":\"teleport\",\"x\":15,\"y\":19,\"target\":\"fields\",\"activation_directions\":\"down\",\"x_target\":18,\"y_target\":2,\"destination_direction\":\"down\",\"dest_collision_layer\":0,\"activation_collision_layers\":0}",
        "tile_event/02": "{\"type\":\"teleport\",\"x\":24,\"y\":1,\"target\":\"mine\",\"activation_directions\":\"up\",\"x_target\":2,\"y_target\":19,\"destination_direction\":\"up\",\"dest_collision_layer\":0,\"activation_collision_layers\":0}",
        "npc/01": "{\"key_name\":\"marker\",\"x\":6,\"y\":7,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"The door is bolted. Folk hide while the Sunspire is dark.\"}",
        "npc/02": "{\"key_name\":\"marker\",\"x\":12,\"y\":7,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"The door is bolted. Folk hide while the Sunspire is dark.\"}",
        "npc/03": "{\"key_name\":\"marker\",\"x\":19,\"y\":7,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"The door is bolted. Folk hide while the Sunspire is dark.\"}",
        "npc/04": "{\"key_name\":\"marker\",\"x\":22,\"y\":11,\"npc_type\":\"inn\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"inn_key\":\"brindle_inn\",\"avatar\":\"ina\",\"voice_key\":\"adult_male_1\"}",
        "npc/05": "{\"key_name\":\"marker\",\"x\":12,\"y\":10,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"BRINDLE MINING TOWN.${BREAK}MINE MOUTH UP THE NORTH PATH. KEEP OUT... PLEASE?\"}",
        "npc/06": "{\"key_name\":\"dov\",\"label\":\"dov\",\"x\":8,\"y\":9,\"npc_type\":\"shop\",\"movement_type\":\"idle\",\"avatar\":\"dov\",\"base_collision_layer\":0,\"message\":\"\",\"shop_key\":\"brindle\"}",
        "npc/07": "{\"key_name\":\"miner\",\"label\":\"miner\",\"x\":20,\"y\":11,\"npc_type\":\"normal\",\"movement_type\":\"random\",\"avatar\":\"miner\",\"base_collision_layer\":0,\"message\":\"\",\"events\":[{\"type\":\"branch\",\"comparator_pairs\":[{\"condition\":\"=\",\"left_comparator_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"ogre\"}},\"right_comparator_value\":{\"type\":\"value\",\"value\":false}}],\"events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"MINER: 'A MAW OGRE nests in the east gallery, squatting on the old SPIRE KEY.'${BREAK}'It flattened three carts. Mind your skulls.'\"}}],\"else_events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"MINER: 'You flattened the ogre?! Drinks on me. Well. One drink.'\"}}]}]}",
        "npc/08": "{\"key_name\":\"ina\",\"label\":\"ina\",\"x\":24,\"y\":13,\"npc_type\":\"normal\",\"movement_type\":\"random\",\"avatar\":\"ina\",\"base_collision_layer\":0,\"message\":\"\",\"events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"INA: 'Papa runs the inn. Twelve coins and you sleep like a golem!'${BREAK}'He snores louder than the mine carts, though. You did not hear that from me.'\"}}]}",
        "npc/09": "{\"key_name\":\"lyn\",\"label\":\"lyn\",\"x\":13,\"y\":10,\"npc_type\":\"normal\",\"movement_type\":\"random\",\"avatar\":\"lyn\",\"base_collision_layer\":0,\"message\":\"\",\"storage_keys\":{\"active\":\"not:lyn_joined\"},\"events\":[{\"type\":\"branch\",\"comparator_pairs\":[{\"condition\":\"=\",\"left_comparator_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"compass\"}},\"right_comparator_value\":{\"type\":\"value\",\"value\":false}}],\"events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"LYN: 'Ari! Took you long enough to crack that boulder.'${BREAK}'I'd come along, but I lost my COMPASS scouting the paddock north of the fence.'${BREAK}'I am not walking into a dark spire without it. Find it and we talk.'\"}}],\"else_events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"LYN: 'My compass! You found it in the paddock? You are more useful than you look.'${BREAK}LYN: 'Fine - someone has to patch you up. Try to keep up.'${BREAK}Ask LYN to join the party?\"},\"end_with_yes_no\":true,\"yes_no_events\":{\"yes\":[{\"type\":\"party_join\",\"char_key_name\":\"lyn\",\"show_dialog\":true,\"finish_events\":[{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"lyn_joined\",\"value\":true}},\"check_npc_storage_values\":true,\"npc_label\":\"lyn\"}]}],\"no\":[]}}]}]}",
