        "tile_event/01": "{\"type\":\"teleport\",\"x\":12,\"y\":21,\"target\":\"trail\",\"activation_directions\":\"down\",\"x_target\":16,\"y_target\":2,\"destination_direction\":\"down\",\"dest_collision_layer\":0,\"activation_collision_layers\":0}",
        "tile_event/02": "{\"type\":\"event_trigger\",\"x\":3,\"y\":17,\"activation_directions\":\"all\",\"activation_collision_layers\":0,\"trigger_once\":true,\"events\":[{\"type\":\"set_char_hp_pp\",\"char_key\":\"all\",\"points_type\":\"hp\",\"value\":\"full\"},{\"type\":\"set_char_hp_pp\",\"char_key\":\"all\",\"points_type\":\"pp\",\"value\":\"full\"},{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"The spirit spring glows. The party is fully restored!\"}}]}",
        "npc/01": "{\"key_name\":\"chest\",\"label\":\"chest_shrine_2_2\",\"storage_keys\":{\"animation\":\"chest_shrine_2_2\"},\"x\":2,\"y\":2,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"\",\"events\":[{\"type\":\"chest\",\"item\":\"steel\",\"standard_chest\":true,\"finish_events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"Equip it from the menu.\"}}]}]}",
        "npc/02": "{\"key_name\":\"chest\",\"label\":\"chest_shrine_23_2\",\"storage_keys\":{\"animation\":\"chest_shrine_23_2\"},\"x\":23,\"y\":2,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"\",\"events\":[{\"type\":\"chest\",\"item\":\"elixir\",\"standard_chest\":true,\"finish_events\":[]}]}",
        "npc/03": "{\"key_name\":\"chest\",\"label\":\"chest_shrine_13_8\",\"storage_keys\":{\"animation\":\"chest_shrine_13_8\"},\"x\":13,\"y\":8,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"\",\"events\":[{\"type\":\"chest\",\"item\":\"sol\",\"standard_chest\":true,\"finish_events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"Equip it from the menu.\"}}]}]}",
        "npc/04": "{\"key_name\":\"mercury_djinn\",\"label\":\"spirit_mist\",\"storage_keys\":{\"active\":\"spirit_mist_free\"},\"x\":4,\"y\":10,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"The WATER spirit MIST bristles and darts into a fighting stance!${BREAK}It will only follow the strong - prove yourselves!${BREAK}Steel barely touches a spirit. Strike with your ARTS!${BREAK}It is quick - it will strike twice each turn!\",\"events\":[{\"type\":\"djinn_get\",\"djinn_key\":\"mist\",\"has_fight\":true,\"enemy_party_key\":\"duel_mist\",\"custom_battle_bg\":\"bg_tower\",\"finish_events\":[{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_mist_free\",\"value\":false}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_mist\",\"value\":true}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirits_found\",\"value\":1}},\"increment\":true},{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"Humbled, the WATER spirit MIST joins you!${BREAK}Each SET spirit strengthens the whole party. Unleash spirits in battle, then SUMMON with the ones on standby!\"}}]}]}",
        "npc/05": "{\"key_name\":\"jupiter_djinn\",\"label\":\"spirit_squall\",\"storage_keys\":{\"active\":\"spirit_squall_free\"},\"x\":22,\"y\":12,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"The WIND spirit SQUALL bristles and darts into a fighting stance!${BREAK}It will only follow the strong - prove yourselves!${BREAK}Steel barely touches a spirit. Strike with your ARTS!${BREAK}It is quick - it will strike twice each turn!\",\"events\":[{\"type\":\"djinn_get\",\"djinn_key\":\"squall\",\"has_fight\":true,\"enemy_party_key\":\"duel_squall\",\"custom_battle_bg\":\"bg_tower\",\"finish_events\":[{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_squall_free\",\"value\":false}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_squall\",\"value\":true}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirits_found\",\"value\":1}},\"increment\":true},{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"Humbled, the WIND spirit SQUALL joins you!${BREAK}Each SET spirit strengthens the whole party. Unleash spirits in battle, then SUMMON with the ones on standby!\"}}]}]}",
        "npc/06": "{\"key_name\":\"wyrm_s\",\"label\":\"boss_wyrm\",\"storage_keys\":{\"active\":\"boss_wyrm_alive\"},\"x\":12,\"y\":2,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"SHADOW WYRM: 'Ssso... children of the dawn come to reclaim the light.'${BREAK}'Four little flames. I will sssnuff you one by one.'\",\"events\":[{\"type\":\"battle\",\"background_key\":\"bg_tower\",\"bgm\":\"battle_boss\",\"enemy_party_key\":\"boss_wyrm\",\"before_fade_victory_events\":[{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"boss_wyrm_alive\",\"value\":false}},\"check_npc_storage_values\":true,\"npc_label\":\"boss_wyrm\"},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"boss_down\",\"value\":true}}}],\"all_enemies_fled_events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"The Wyrm lets out a final shriek...${BREAK}The Wyrm dissolves into mist!${BREAK}Warm light floods the Sunspire!\"},\"finish_events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"THE SUNSPIRE SHINES ANEW${BREAK}THANKS FOR PLAYING\"},\"finish_events\":[{\"type\":\"teleport\",\"target_map_key\":\"fields\",\"target_tile_position\":{\"x\":18,\"y\":22},\"target_collision_layer\":0,\"target_direction\":\"down\",\"fade_color\":\"0x0\"}]}]}]}]}",
