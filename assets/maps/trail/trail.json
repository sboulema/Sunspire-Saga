        "tile_event/01": "{\"type\":\"teleport\",\"x\":1,\"y\":10,\"target\":\"mine\",\"activation_directions\":\"left\",\"x_target\":24,\"y_target\":10,\"destination_direction\":\"left\",\"dest_collision_layer\":0,\"activation_collision_layers\":0}",
        "tile_event/02": "{\"type\":\"teleport\",\"x\":16,\"y\":0,\"target\":\"shrine\",\"activation_directions\":\"up\",\"x_target\":12,\"y_target\":19,\"destination_direction\":\"up\",\"dest_collision_layer\":0,\"activation_collision_layers\":0}",
        "npc/01": "{\"key_name\":\"chest\",\"label\":\"chest_trail_12_4\",\"storage_keys\":{\"animation\":\"chest_trail_12_4\"},\"x\":12,\"y\":4,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"\",\"events\":[{\"type\":\"chest\",\"item\":\"chain\",\"standard_chest\":true,\"finish_events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"Equip it from the menu.\"}}]}]}",
        "npc/02": "{\"key_name\":\"chest\",\"label\":\"chest_trail_25_16\",\"storage_keys\":{\"animation\":\"chest_trail_25_16\"},\"x\":25,\"y\":16,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"\",\"events\":[{\"type\":\"chest\",\"item\":\"potion\",\"standard_chest\":true,\"finish_events\":[]}]}",
        "npc/03": "{\"key_name\":\"mars_djinn\",\"label\":\"spirit_ember\",\"storage_keys\":{\"active\":\"spirit_ember_free\"},\"x\":28,\"y\":16,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"The FIRE spirit EMBER bristles and darts into a fighting stance!${BREAK}It will only follow the strong - prove yourselves!${BREAK}Steel barely touches a spirit. Strike with your ARTS!${BREAK}It is quick - it will strike twice each turn!\",\"events\":[{\"type\":\"djinn_get\",\"djinn_key\":\"ember\",\"has_fight\":true,\"enemy_party_key\":\"duel_ember\",\"custom_battle_bg\":\"bg_trail\",\"finish_events\":[{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_ember_free\",\"value\":false}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_ember\",\"value\":true}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirits_found\",\"value\":1}},\"increment\":true},{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"Humbled, the FIRE spirit EMBER joins you!${BREAK}Each SET spirit strengthens the whole party. Unleash spirits in battle, then SUMMON with the ones on standby!\"}}]}]}",
        "npc/04": "{\"key_name\":\"jupiter_djinn\",\"label\":\"spirit_breeze\",\"storage_keys\":{\"active\":\"spirit_breeze_free\"},\"x\":29,\"y\":3,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"The WIND spirit BREEZE bristles and darts into a fighting stance!${BREAK}It will only follow the strong - prove yourselves!${BREAK}Steel barely touches a spirit. Strike with your ARTS!${BREAK}It is quick - it will strike twice each turn!\",\"events\":[{\"type\":\"djinn_get\",\"djinn_key\":\"breeze\",\"has_fight\":true,\"enemy_party_key\":\"duel_breeze\",\"custom_battle_bg\":\"bg_trail\",\"finish_events\":[{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_breeze_free\",\"value\":false}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_breeze\",\"value\":true}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirits_found\",\"value\":1}},\"increment\":true},{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"Humbled, the WIND spirit BREEZE joins you!${BREAK}Each SET spirit strengthens the whole party. Unleash spirits in battle, then SUMMON with the ones on standby!\"}}]}]}",
        "npc/05": "{\"key_name\":\"gate\",\"label\":\"gate\",\"storage_keys\":{\"active\":\"not:gate_open\"},\"x\":16,\"y\":1,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"\",\"events\":[{\"type\":\"branch\",\"comparator_pairs\":[{\"condition\":\"=\",\"left_comparator_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spire_key\"}},\"right_comparator_value\":{\"type\":\"value\",\"value\":true}}],\"events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"The SPIRE KEY turns. Ancient bolts grind open!${BREAK}The Sunspire awaits.\"},\"finish_events\":[{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"gate_open\",\"value\":true}},\"check_npc_storage_values\":true,\"npc_label\":\"gate\"}]}],\"else_events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"A sealed gate bars the spire steps.${BREAK}A heavy keyhole glints. Something in the mine may fit it.\"}}]}]}",
        "interactable_object/01": "{\"key_name\":\"loose_boulder\",\"x\":8,\"y\":13,\"base_collision_layer\":0,\"allowed_tiles\":[{\"type\":\"rect\",\"x0\":8,\"y0\":10,\"x1\":8,\"y1\":13,\"collision_layer\":0}]}",
        "game_events": "[{\"type\":\"branch\",\"comparator_pairs\":[{\"condition\":\"=\",\"left_comparator_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"sera_joined\"}},\"right_comparator_value\":{\"type\":\"value\",\"value\":false}}],\"events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"A scout drops from a ledge, bow drawn... then lowers it.${BREAK}SERA: 'Climbers! Finally. The harpies have me pinned down for days.'${BREAK}'Heading for the spire gate? Then we share a road.'${BREAK}SERA joined the party!\"},\"finish_events\":[{\"type\":\"party_join\",\"char_key_name\":\"sera\",\"show_dialog\":false},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"sera_joined\",\"value\":true}}}]}],\"else_events\":[]}]",
