        "npc/03": "{\"key_name\":\"chest\",\"label\":\"chest_mine_13_12\",\"storage_keys\":{\"animation\":\"chest_mine_13_12\"},\"x\":13,\"y\":12,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"\",\"events\":[{\"type\":\"chest\",\"item\":\"pdrop\",\"standard_chest\":true,\"finish_events\":[]}]}",
        "npc/04": "{\"key_name\":\"venus_djinn\",\"label\":\"spirit_granite\",\"storage_keys\":{\"active\":\"spirit_granite_free\"},\"x\":3,\"y\":18,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"The EARTH spirit GRANITE bristles and darts into a fighting stance!${BREAK}It will only follow the strong - prove yourselves!${BREAK}Steel barely touches a spirit. Strike with your ARTS!\",\"events\":[{\"type\":\"djinn_get\",\"djinn_key\":\"granite\",\"has_fight\":true,\"enemy_party_key\":\"duel_granite\",\"custom_battle_bg\":\"bg_mine\",\"finish_events\":[{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_granite_free\",\"value\":false}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_granite\",\"value\":true}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirits_found\",\"value\":1}},\"increment\":true},{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"Humbled, the EARTH spirit GRANITE joins you!${BREAK}Each SET spirit strengthens the whole party. Unleash spirits in battle, then SUMMON with the ones on standby!\"}}]}]}",
        "npc/05": "{\"key_name\":\"mars_djinn\",\"label\":\"spirit_forge\",\"storage_keys\":{\"active\":\"spirit_forge_free\"},\"x\":12,\"y\":3,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"The FIRE spirit FORGE bristles and darts into a fighting stance!${BREAK}It will only follow the strong - prove yourselves!${BREAK}Steel barely touches a spirit. Strike with your ARTS!\",\"events\":[{\"type\":\"djinn_get\",\"djinn_key\":\"forge\",\"has_fight\":true,\"enemy_party_key\":\"duel_forge\",\"custom_battle_bg\":\"bg_mine\",\"finish_events\":[{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_forge_free\",\"value\":false}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirit_forge\",\"value\":true}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spirits_found\",\"value\":1}},\"increment\":true},{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"Humbled, the FIRE spirit FORGE joins you!${BREAK}Each SET spirit strengthens the whole party. Unleash spirits in battle, then SUMMON with the ones on standby!\"}}]}]}",
        "npc/06": "{\"key_name\":\"ogre_s\",\"label\":\"boss_ogre\",\"storage_keys\":{\"active\":\"boss_ogre_alive\"},\"x\":25,\"y\":10,\"npc_type\":\"normal\",\"movement_type\":\"idle\",\"base_collision_layer\":0,\"message\":\"The tunnel shakes. A mountain of muscle rises from a nest of splintered carts.${BREAK}MAW OGRE: 'GRRAAH! MY tunnel! MY shiny key!'\",\"events\":[{\"type\":\"battle\",\"background_key\":\"bg_mine\",\"bgm\":\"battle_boss\",\"enemy_party_key\":\"boss_ogre\",\"before_fade_victory_events\":[{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"boss_ogre_alive\",\"value\":false}},\"check_npc_storage_values\":true,\"npc_label\":\"boss_ogre\"},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"ogre\",\"value\":true}}},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"spire_key\",\"value\":true}}}],\"all_enemies_fled_events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"OBTAINED THE SPIRE KEY!\"}}]}]}",
        "game_events": "[{\"type\":\"branch\",\"comparator_pairs\":[{\"condition\":\"=\",\"left_comparator_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"bram_joined\"}},\"right_comparator_value\":{\"type\":\"value\",\"value\":false}}],\"events\":[{\"type\":\"dialog\",\"dialog_info\":{\"text\":\"A broad miner blocks the tunnel... then grins.${BREAK}BRAM: 'You're the kids hunting spirits? These tunnels eat travelers.'${BREAK}'I know every shaft. I'm coming - my pick and my fire both.'${BREAK}BRAM joined the party!\"},\"finish_events\":[{\"type\":\"party_join\",\"char_key_name\":\"bram\",\"show_dialog\":false},{\"type\":\"set_value\",\"event_value\":{\"type\":\"storage\",\"value\":{\"key_name\":\"bram_joined\",\"value\":true}}}]}],\"else_events\":[]}]",
