{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path'),T={'.html':'text/html','.js':'text/javascript','.css':'text/css','.png':'image/png','.ico':'image/x-icon','.json':'application/json','.webp':'image/webp','.svg':'image/svg+xml'};h.createServer((q,r)=>{const [path,qs]=q.url.split('?'),s=qs===undefined?'':'?'+qs;let m;if(/^\\/index(\\.html)?$/.test(path)){r.writeHead(301,{Location:'/'+s});return r.end()}if((m=path.match(/^\\/(.+)\\.html$/))){r.writeHead(301,{Location:'/'+m[1]+s});return r.end()}let u=decodeURIComponent(path);if(u.endsWith('/'))u+='index.html';let fp=p.join(process.cwd(),u);if(!p.extname(fp)&&f.existsSync(fp+'.html'))fp+='.html';f.readFile(fp,(e,d)=>{if(e){r.writeHead(404);return r.end('404')}r.writeHead(200,{'Content-Type':T[p.extname(fp)]||'application/octet-stream','Cache-Control':'no-store'});r.end(d)})}).listen(8642,()=>console.log('listening 8642'))"],
      "port": 8642
    }
  ]
}
